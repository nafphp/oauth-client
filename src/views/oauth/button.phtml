<?php
/**
 * The default sign-in button.
 *
 * Copy this file to your application's view directory as oauth/button.phtml to
 * change the markup. Your copy wins; nothing in the central configuration has to
 * change for it.
 *
 * @var string $provider Configured provider key, e.g. "google".
 * @var string $label    What the button says.
 * @var string $url      Where it goes.
 */
?>
<a class="oauth-button oauth-button--<?= htmlspecialchars($provider, ENT_QUOTES, 'UTF-8') ?>"
   href="<?= htmlspecialchars($url, ENT_QUOTES, 'UTF-8') ?>"
   rel="nofollow"><?= htmlspecialchars($label, ENT_QUOTES, 'UTF-8') ?></a>
